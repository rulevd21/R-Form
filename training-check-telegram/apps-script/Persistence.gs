function tcIngestAppend_(eventId,checkId,participantId,source,status,note,payloadSafe){const ss=tcSs_(),s=tcRequireSheet_(ss,RFORM_TCV1.SHEETS.INGEST),h=tcHeaderMap_(s),row=Math.max(2,s.getLastRow()+1);tcSetRowValues_(s,h,row,{event_id:eventId,received_at:tcNowIso_(),check_id:checkId||'',participant_id:participantId||'',source:source||'',client_version:RFORM_TCV1.VERSION,payload_json:JSON.stringify(payloadSafe||{}),processing_status:status,error_code:'',note:note||''});return{sheet:s,h:h,row:row};}
function tcIngestStatus_(entry,status,error,note){tcSetRowValues_(entry.sheet,entry.h,entry.row,{processing_status:status,error_code:error||'',note:note||''});}
function tcHistory_(participantId,limit){limit=Math.max(1,Math.min(10,Number(limit||3)));const ss=tcSs_(),s=tcRequireSheet_(ss,RFORM_TCV1.SHEETS.CHECKS),h=tcHeaderMap_(s),out=[],last=s.getLastRow();if(last<2)return out;const vals=s.getRange(2,1,last-1,s.getLastColumn()).getDisplayValues();for(let i=vals.length-1;i>=0&&out.length<limit;i--){if(String(vals[i][h.participant_id-1])!==String(participantId))continue;const st=String(vals[i][h.test_status-1]);if(st!=='REPORTED'&&st!=='COMPLETED')continue;const o={};Object.keys(h).forEach(function(k){o[k]=vals[i][h[k]-1];});let input={};try{input=JSON.parse(o.input_json||'{}');}catch(_){}out.unshift({check_id:o.check_id,session_date:o.session_date,input:input,analysis:{fact:o.fact,signal:o.analyst_key_deviation,signal_code:o.signal_code,interpretation:o.analyst_interpretation,decision_direction:o.recommendation_summary,checkpoint:o.report_next_step,comparison_status:o.comparison_status,comparison_note:o.comparison_note,trend_status:o.trend_status,confidence:o.confidence,insufficient_data:String(o.insufficient_data).toUpperCase()==='TRUE',safety_flag:String(o.safety_flag).toUpperCase()==='TRUE'},checkpoint_status:o.checkpoint_status,next_checkpoint_date:o.next_checkpoint_date});}return out;}
function tcValidateCheckInput_(p){if(!p||typeof p!=='object')throw new Error('PAYLOAD_INVALID');['exercise_name','actual_sets','actual_reps','overall_result'].forEach(function(k){if(String(p[k]||'').trim()==='')throw new Error('FIELD_REQUIRED:'+k);});if(String(p.actual_rir||'').trim()===''&&String(p.effort||'').trim()==='')throw new Error('FIELD_REQUIRED:intensity');if(JSON.stringify(p).length>RFORM_TCV1.MAX_PAYLOAD_CHARS)throw new Error('PAYLOAD_TOO_LARGE');}
function tcBuildPlanText_(p){const a=[];if(p.exercise_name)a.push(String(p.exercise_name));if(p.plan_load)a.push(String(p.plan_load)+' '+String(p.load_unit||'кг'));if(p.plan_sets&&p.plan_reps)a.push(String(p.plan_sets)+'×'+String(p.plan_reps));if(p.target_rir)a.push('RIR '+String(p.target_rir));return a.join(' · ')||String(p.training_goal||'');}
function tcBuildFactText_(p){const a=[];if(p.exercise_name)a.push(String(p.exercise_name));if(p.actual_load)a.push(String(p.actual_load)+' '+String(p.load_unit||'кг'));if(p.actual_sets&&p.actual_reps)a.push(String(p.actual_sets)+'×'+String(p.actual_reps));if(p.actual_rir)a.push('RIR '+String(p.actual_rir));return a.join(' · ')||String(p.overall_result||'');}
function tcSubmitCheck_(participant,eventId,payload){if(!tcWritesEnabled_())throw new Error('PRODUCTION_WRITES_DISABLED');tcValidateCheckInput_(payload);const lock=LockService.getScriptLock();lock.waitLock(15000);try{const dup=tcIngestFind_(eventId);if(dup&&dup.obj.processing_status==='APPLIED'){const hit=tcHistory_(participant.participant_id,10).filter(function(x){return x.check_id===dup.obj.check_id;})[0];if(hit)return hit;}const history=tcHistory_(participant.participant_id,3);payload.goal=participant.goal||payload.goal||'';const analysis=RFormAnalyzer.analyzeTrainingCheck(payload,history),ss=tcSs_(),s=tcRequireSheet_(ss,RFORM_TCV1.SHEETS.CHECKS),h=tcHeaderMap_(s),row=Math.max(2,s.getLastRow()+1),checkId='RTC-TG-'+Utilities.formatDate(new Date(),'Etc/UTC','yyyyMMdd')+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase(),plan=tcBuildPlanText_(payload),fact=tcBuildFactText_(payload),intensity=[payload.actual_rir?('RIR '+payload.actual_rir):'',payload.effort||''].filter(Boolean).join(' · ');tcSetRowValues_(s,h,row,{check_id:checkId,participant_id:participant.participant_id,test_status:'REPORTED',test_date:String(payload.session_date||'').slice(0,10),session_date:String(payload.session_date||'').slice(0,10),training_context:'TELEGRAM_V1',plan:plan,fact:fact,rir_summary:intensity,quality_comment:String(payload.quality_comment||payload.quality_rating||''),participant_decision:'',analyst_key_deviation:analysis.signal,analyst_interpretation:analysis.interpretation,report_next_step:analysis.checkpoint,data_quality:analysis.insufficient_data?'PARTIAL':'COMPLETE',analyst:'RFORM_DETERMINISTIC',reported_at:tcNowIso_(),recommendation_status:'READY',recommendation_summary:analysis.decision_direction,analysis_engine:analysis.engine,analysis_version:analysis.version,signal_code:analysis.signal_code,comparison_status:analysis.comparison_status,comparison_note:analysis.comparison_note,trend_status:analysis.trend_status,confidence:analysis.confidence,insufficient_data:analysis.insufficient_data,safety_flag:analysis.safety_flag,checkpoint_status:'PROPOSED',input_json:JSON.stringify(payload),portable_prompt_version:RFORM_TCV1.PORTABLE_PROMPT_VERSION});tcIngestAppend_(eventId,checkId,participant.participant_id,'MINI_APP','APPLIED','Training Check stored',{action:'check_submit'});const ps=tcRequireSheet_(ss,RFORM_TCV1.SHEETS.PARTICIPANTS),ph=tcHeaderMap_(ps),prow=tcFindRow_(ps,ph.participant_id,participant.participant_id);if(prow)tcSetRowValues_(ps,ph,prow,{current_check_id:checkId,profile_updated_at:tcNowIso_()});tcEvent_(participant.participant_id,checkId,'check_completed','MINI_APP',participant.is_test_user,{signal_code:analysis.signal_code});tcEvent_(participant.participant_id,checkId,'analysis_completed','SERVER',participant.is_test_user,{engine:analysis.engine,version:analysis.version});tcEvent_(participant.participant_id,checkId,'checkpoint_proposed','SERVER',participant.is_test_user,{});SpreadsheetApp.flush();return{check_id:checkId,session_date:String(payload.session_date||'').slice(0,10),input:payload,analysis:analysis,checkpoint_status:'PROPOSED'};}finally{lock.releaseLock();}}
