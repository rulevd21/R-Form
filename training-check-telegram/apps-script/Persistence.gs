function tcSs_(){return SpreadsheetApp.openById(RFORM_TCV1.DATASTORE_ID);}
function tcRequireSheet_(ss,name){const s=ss.getSheetByName(name);if(!s)throw new Error('SHEET_MISSING:'+name);return s;}
function tcHeaderMap_(sheet){const n=sheet.getLastColumn(),h=sheet.getRange(1,1,1,n).getDisplayValues()[0];return h.reduce(function(m,v,i){if(v)m[String(v).trim()]=i+1;return m;},{});}
function tcRequireHeaders_(h,names,sheetName){const missing=names.filter(function(n){return !h[n];});if(missing.length)throw new Error('SCHEMA_MISMATCH:'+sheetName+':'+missing.join(','));}
function tcFindRow_(sheet,col,value){const last=sheet.getLastRow();if(last<2)return 0;const vals=sheet.getRange(2,col,last-1,1).getDisplayValues(),t=String(value||'');for(let i=vals.length-1;i>=0;i--)if(String(vals[i][0])===t)return i+2;return 0;}
function tcSetRowValues_(sheet,h,row,obj){Object.keys(obj).forEach(function(k){if(h[k])sheet.getRange(row,h[k]).setValue(obj[k]);});}
function tcRowObject_(sheet,h,row){const vals=sheet.getRange(row,1,1,sheet.getLastColumn()).getDisplayValues()[0],o={};Object.keys(h).forEach(function(k){o[k]=vals[h[k]-1];});return o;}
function tcNewId_(prefix){return prefix+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase();}
function tcNowIso_(){return new Date().toISOString();}
